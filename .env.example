# Geospatial File Measurement API Configuration
PROJECT_NAME="Geospatial File Measurement API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# File Storage Limits
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB=50

# Database
DATABASE_URL="sqlite:///./storage/geomeasure.db"

# Archive Extraction Safety Limits
MAX_ARCHIVE_EXTRACTED_SIZE_MB=150
MAX_ARCHIVE_MEMBERS=100
